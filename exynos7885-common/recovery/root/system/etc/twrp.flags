# mount point	fstype	device	device2						flags
/product_image    emmc    /dev/block/platform/13500000.dwmmc0/by-name/product    flags=backup=1;flashimg;display="Product Image"
/system_image    emmc    /dev/block/platform/13500000.dwmmc0/by-name/system    flags=backup=1;flashimg;display="System Image"
/vendor_image    emmc    /dev/block/platform/13500000.dwmmc0/by-name/vendor    flags=backup=1;flashimg;display="Vendor Image"
/omr_image    emmc    /dev/block/platform/13500000.dwmmc0/by-name/omr    flags=backup=1;flashimg;display="OMR Image"
/boot		emmc	/dev/block/platform/13500000.dwmmc0/by-name/boot	flags=backup=1;display="Boot";flashimg
/recovery	emmc	/dev/block/platform/13500000.dwmmc0/by-name/recovery	flags=backup=1;display="Recovery";flashimg
/param		emmc	/dev/block/platform/13500000.dwmmc0/by-name/param	flags=backup=1;display="Param"
/dtb		emmc	/dev/block/platform/13500000.dwmmc0/by-name/dtb		flags=backup=1;display="DTB";flashimg
/dtbo		emmc	/dev/block/platform/13500000.dwmmc0/by-name/dtbo	flags=backup=1;display="DTBO";flashimg

/product    ext4    /dev/block/platform/13500000.dwmmc0/by-name/product    flags=backup=1;wipeingui;display="Product"
/system_root    ext4    /dev/block/platform/13500000.dwmmc0/by-name/system    flags=backup=1;wipeingui;display="System"
/vendor    ext4    /dev/block/platform/13500000.dwmmc0/by-name/vendor    flags=backup=1;wipeingui;display="Vendor"
/data		ext4	/dev/block/platform/13500000.dwmmc0/by-name/userdata	flags=encryptable=footer
/cache		ext4	/dev/block/platform/13500000.dwmmc0/by-name/cache	flags=backup=0;display="Cache"
/efs		ext4	/dev/block/platform/13500000.dwmmc0/by-name/efs		flags=backup=1;display="EFS";fsflags="ro"
/cpefs		ext4	/dev/block/platform/13500000.dwmmc0/by-name/cpefs	flags=backup=1;display="CPEFS";subpartitionof=/efs;fsflags="ro"
/omr            ext4    /dev/block/platform/13500000.dwmmc0/by-name/omr         flags=backup=1;display="OMR"

# Removable storage
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1		flags=storage;wipeingui;removable
/usb-otg	vfat	/dev/block/sda1		/dev/block/sda			flags=display="USB-OTG";storage;wipeingui;removable
